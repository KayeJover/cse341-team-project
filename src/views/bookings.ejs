
let bookingChangePending = false;
let currentPage = 1;
let totalPages = 1;

const updatePaginationControls = () => {
    const previousButton = document.getElementById("previous-page");
    const nextButton = document.getElementById("next-page");
    const pageInfo = document.getElementById("page-info");

    if (previousButton) {
        previousButton.disabled = currentPage <= 1;
    }

    if (nextButton) {
        nextButton.disabled = currentPage >= totalPages;
    }

    if (pageInfo) {
        pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;
    }
};

// Get the currently selected booking filters.
const getBookingFilters = () => ({
    ticketClass: document.getElementById("filter-ticket-class")?.value || "",
    startDate: document.getElementById("filter-start-date")?.value || "",
    endDate: document.getElementById("filter-end-date")?.value || "",
});

// Build the API URL with pagination and active filters.
const buildBookingsUrl = () => {
    const params = new URLSearchParams();
    const filters = getBookingFilters();

    params.set("page", currentPage);

    Object.entries(filters).forEach(([key, value]) => {
        if (value) {
            params.set(key, value);
        }
    });

    return `/api/bookings?${params.toString()}`;
};

const changeBooking = async (bookingId, method, status) => {
    const errorEl = document.getElementById("bookings-error");
    const feedbackEl = document.getElementById("bookings-feedback");
    const list = document.getElementById("bookings-list");

    const controls = list.querySelectorAll("button, select");
    const isUpdate = method === "PUT";
    const options = { method };

    if (isUpdate) {
        options.headers = { "Content-Type": "application/json" };
        options.body = JSON.stringify({ status });
    }

    bookingChangePending = true;

    controls.forEach((control) => {
        control.disabled = true;
    });

    errorEl.hidden = true;
    feedbackEl.hidden = true;

    try {
        const response = await fetch(
            `/api/bookings/${encodeURIComponent(bookingId)}`,
            options
        );

        if (!response.ok) {
            let failure = null;

            try {
                failure = await response.json();
            } catch {
                // Use the HTTP status message if the response is not JSON.
            }

            throw new Error(
                failure?.message ||
                `Unable to change booking (${response.status}).`
            );
        }

        feedbackEl.textContent = isUpdate
            ? "Booking updated."
            : "Booking deleted.";

        feedbackEl.hidden = false;

        await loadBookings();
    } catch (error) {
        errorEl.textContent = error.message;
        errorEl.hidden = false;
    } finally {
        bookingChangePending = false;

        controls.forEach((control) => {
            control.disabled = false;
        });
    }
};

const loadBookings = async () => {
    const listEl = document.getElementById("bookings-list");
    const templateEl = document.getElementById("booking-row-template");
    const loadingEl = document.getElementById("bookings-loading");
    const errorEl = document.getElementById("bookings-error");

    if (!listEl || !templateEl) {
        return;
    }

    loadingEl.hidden = false;
    errorEl.hidden = true;

    try {
        const response = await fetch(buildBookingsUrl());

        if (!response.ok) {
            let failure = null;

            try {
                failure = await response.json();
            } catch {
                // Use the HTTP status message if the response is not JSON.
            }

            throw new Error(
                failure?.message ||
                `Failed to load bookings (${response.status}).`
            );
        }

        const payload = await response.json();
        const bookings = payload.bookings || [];
        const pagination = payload.pagination || {};

        totalPages = Math.max(1, pagination.totalPages || 1);

        // Handle an empty last page after deleting a booking.
        if (currentPage > totalPages) {
            currentPage = totalPages;
            await loadBookings();
            return;
        }

        const totalEl = document.getElementById("total-bookings");
        const confirmedEl = document.getElementById("confirmed-bookings");

        if (totalEl) {
            totalEl.textContent =
                pagination.totalBookings ?? payload.count ?? 0;
        }

        if (confirmedEl) {
            confirmedEl.textContent = bookings.filter(
                (booking) => booking.status === "confirmed"
            ).length;
        }

        if (bookings.length === 0) {
            listEl.innerHTML = `
                <tr>
                    <td colspan="9">No bookings found.</td>
                </tr>
            `;
        } else {
            const fragment = document.createDocumentFragment();

            bookings.forEach((booking) => {
                const row = templateEl.content.cloneNode(true);

                row.querySelector('[data-field="id"]').textContent =
                    booking.id || "N/A";

                row.querySelector('[data-field="schedule"]').textContent =
                    booking.scheduleId ?? "N/A";

                row.querySelector('[data-field="trip"]').textContent =
                    booking.tripId || "N/A";

                row.querySelector('[data-field="passengers"]').textContent =
                    booking.passengers?.length ?? 0;

                row.querySelector('[data-field="ticket-class"]').textContent =
                    booking.ticketClass || "N/A";

                row.querySelector('[data-field="amount"]').textContent =
                    booking.totalAmount != null
                        ? `₹${Number(booking.totalAmount).toFixed(2)}`
                        : "N/A";

                row.querySelector('[data-field="status"]').textContent =
                    booking.status || "N/A";

                row.querySelector('[data-field="created"]').textContent =
                    booking.createdAt
                        ? new Date(booking.createdAt).toLocaleDateString()
                        : "N/A";

                const form = row.querySelector(".booking-actions");
                const status = form.elements.namedItem("status");

                status.value = booking.status;

                form.setAttribute(
                    "aria-label",
                    `Actions for booking ${booking.id}`
                );

                form.addEventListener("submit", (event) => {
                    event.preventDefault();

                    if (!bookingChangePending && status.value) {
                        changeBooking(
                            booking.id,
                            "PUT",
                            status.value
                        );
                    }
                });

                form.querySelector('[data-action="delete"]')
                    .addEventListener("click", () => {
                        if (
                            !bookingChangePending &&
                            window.confirm(`Delete booking ${booking.id}?`)
                        ) {
                            changeBooking(booking.id, "DELETE");
                        }
                    });

                fragment.appendChild(row);
            });

            listEl.replaceChildren(fragment);
        }

        updatePaginationControls();

    } catch (error) {
        console.error("Error loading bookings:", error);

        errorEl.hidden = false;
        errorEl.textContent = error.message ||
            "Unable to load bookings right now. Please try again.";
    } finally {
        loadingEl.hidden = true;
    }
};

document.addEventListener("DOMContentLoaded", () => {
    const previousButton = document.getElementById("previous-page");
    const nextButton = document.getElementById("next-page");

    const filterForm = document.getElementById("booking-filters");
    const clearFiltersButton = document.getElementById(
        "clear-booking-filters"
    );

    // Apply selected filters.
    filterForm?.addEventListener("submit", (event) => {
        event.preventDefault();

        const filters = getBookingFilters();

        if (
            filters.startDate &&
            filters.endDate &&
            filters.startDate > filters.endDate
        ) {
            const errorEl = document.getElementById("bookings-error");

            errorEl.textContent =
                "Start date cannot be after end date.";
            errorEl.hidden = false;

            return;
        }

        currentPage = 1;

        loadBookings();
    });

    // Clear all filters and reload the first page.
    clearFiltersButton?.addEventListener("click", () => {
        filterForm?.reset();

        currentPage = 1;

        const errorEl = document.getElementById("bookings-error");
        const feedbackEl = document.getElementById("bookings-feedback");

        errorEl.hidden = true;
        feedbackEl.hidden = true;

        loadBookings();
    });

    // Previous page.
    previousButton?.addEventListener("click", () => {
        if (currentPage > 1) {
            currentPage--;
            loadBookings();
        }
    });

    // Next page.
    nextButton?.addEventListener("click", () => {
        if (currentPage < totalPages) {
            currentPage++;
            loadBookings();
        }
    });

    loadBookings();
});

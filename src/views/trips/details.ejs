<%- include('../partials/header') %>

    <article class="route-detail" id="trip-details" data-trip-id="<%= details.id %>">
        <div class="route-header">
            <div class="route-header-content">
                <h1 class="route-name" id="trip-name">
                    <%= details.name %>
                </h1>

                <p class="route-description" id="trip-description">
                    <%= details.description %>
                </p>

                <div class="highlights" id="trip-highlights">
                    <% if (details.highlights && details.highlights.length> 0) { %>
                        <% details.highlights.forEach(function(highlight) { %>
                            <span class="highlight-tag">
                                <%= highlight %>
                            </span>
                            <% }); %>
                                <% } %>
                </div>
            </div>

            <div class="route-image" id="trip-image-container" <% if (!details.imageUrl) { %>hidden<% } %>>
                    <img id="trip-image" src="<%= details.imageUrl || '' %>" alt="<%= details.name %>">
            </div>
        </div>

        <div class="route-info">
            <div class="info-grid">
                <div class="info-item">
                    <span class="info-label">Region</span>
                    <span class="info-value" id="trip-region">
                        <%= details.region.charAt(0).toUpperCase() + details.region.slice(1) %>
                    </span>
                </div>

                <div class="info-item">
                    <span class="info-label">Duration</span>
                    <span class="info-value" id="trip-duration">
                        <%= details.duration %>
                    </span>
                </div>

                <div class="info-item">
                    <span class="info-label">Distance</span>
                    <span class="info-value" id="trip-distance">
                        <%= details.distance %> km
                    </span>
                </div>

                <div class="info-item">
                    <span class="info-label">Best Season</span>
                    <span class="info-value" id="trip-best-season">
                        <%= details.bestSeason.charAt(0).toUpperCase() + details.bestSeason.slice(1) %>
                    </span>
                </div>
            </div>

            <div class="route-stations">
                <h2>Trip</h2>

                <div class="stations">
                    <div class="station">
                        <span class="station-label">Start</span>
                        <span class="station-name" id="trip-start-station">
                            <%= details.startStation.charAt(0).toUpperCase() + details.startStation.slice(1) %>
                        </span>
                    </div>

                    <div class="station">
                        <span class="station-label">End</span>
                        <span class="station-name" id="trip-end-station">
                            <%= details.endStation.charAt(0).toUpperCase() + details.endStation.slice(1) %>
                        </span>
                    </div>
                </div>
            </div>

            <div class="route-operating">
                <h2>Operating Schedule</h2>

                <div class="months-grid" id="trip-operating-months">
                    <% details.operatingMonths.forEach(function(month) { %>
                        <span class="month-badge">
                            <%= month %>
                        </span>
                        <% }); %>
                </div>
            </div>

            <% if (details.schedules && details.schedules.length> 0) { %>
                <div class="route-schedules">
                    <h2>Available Schedules</h2>

                    <div class="schedules-grid">
                        <% details.schedules.forEach(function(schedule) { %>
                            <div class="schedule-card">
                                <div class="schedule-times">
                                    <div class="time-block">
                                        <span class="time-label">Departs</span>
                                        <span class="time-value">
                                            <%= schedule.departureTime %>
                                        </span>
                                    </div>

                                    <span class="time-arrow">→</span>

                                    <div class="time-block">
                                        <span class="time-label">Arrives</span>
                                        <span class="time-value">
                                            <%= schedule.arrivalTime %>
                                        </span>
                                    </div>
                                </div>

                                <div class="schedule-days">
                                    <% schedule.daysOfWeek.forEach(function(day) { %>
                                        <span class="day-badge">
                                            <%= day.substring(0, 3) %>
                                        </span>
                                        <% }); %>
                                </div>

                                <a href="/trips/booking/<%= schedule.id %>" class="book-btn">
                                    Book Now
                                </a>
                            </div>
                            <% }); %>
                    </div>
                </div>
                <% } %>
        </div>
    </article>

    <script src="/js/trip-details.js" defer></script>

    <%- include('../partials/footer') %>
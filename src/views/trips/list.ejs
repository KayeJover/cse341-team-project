
<%- include('../partials/header') %>

<h1><%= title %></h1>

<div id="filters">
    <label for="keyword-search">Search Trips:</label>
    <input
        type="search"
        id="keyword-search"
        placeholder="Search by trip name or description"
    />
    
    <label for="region-filter">Search by Region:</label>
    <select id="region-filter">
        <option value="all">All Regions</option>
    </select>

    <label for="season-filter">Search by Season:</label>
    <select id="season-filter">
        <option value="all">Any Season</option>
    </select>
</div>

<div class="routes-grid" id="routes-grid">
    <p id="trips-loading">Loading trips...</p>
</div>

<!-- Pagination controls -->
<div id="pagination-controls"></div>

<script src="/js/trips.js" defer></script>

<%- include('../partials/footer') %>

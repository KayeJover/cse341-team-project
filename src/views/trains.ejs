<%- include('./partials/header') %>

    <section class="trains-hero">
        <h1>Learn about our Trains</h1>
        <p>
            Explore the physical trains that power scenic trips across the Kizuna Rail network.
        </p>
    </section>

    <section class="trains-catalog">

        <!-- Train Search -->
        <form class="trains-search" id="trains-search-form">
            <label for="trains-search">Search trains</label>

            <div class="trains-search-controls">
                <input type="search" id="trains-search" name="search"
                    placeholder="Search by train name, operator, or type..." maxlength="100">

                <button type="submit" id="trains-search-button">
                    Search
                </button>
            </div>
        </form>

        <!-- Loading and Error Messages -->
        <div class="trains-state" id="trains-loading">
            Loading trains...
        </div>

        <div class="trains-state trains-error" id="trains-error" hidden></div>

        <!-- Train Cards -->
        <div class="trains-grid" id="trains-list"></div>

        <!-- Pagination -->
        <div class="trains-pagination" id="trains-pagination" hidden>
            <button type="button" id="trains-previous" disabled>
                Previous
            </button>

            <span id="trains-page-info">Page 1 of 1</span>

            <button type="button" id="trains-next">
                Next
            </button>
        </div>

        <!-- Train Card Template -->
        <template id="train-card-template">
            <article class="train-card">
                <div class="train-image-wrap">
                    <img data-field="image" loading="lazy" decoding="async">
                </div>

                <header class="train-card-header">
                    <h2 data-field="name"></h2>
                    <span class="train-operator" data-field="operator"></span>
                </header>

                <p class="train-description" data-field="description"></p>

                <dl class="train-specs">
                    <div class="spec-item">
                        <dt>Type</dt>
                        <dd data-field="type"></dd>
                    </div>

                    <div class="spec-item">
                        <dt>Top Speed</dt>
                        <dd data-field="speed"></dd>
                    </div>

                    <div class="spec-item">
                        <dt>Capacity</dt>
                        <dd data-field="seats"></dd>
                    </div>

                    <div class="spec-item">
                        <dt>Power</dt>
                        <dd data-field="power"></dd>
                    </div>
                </dl>

                <p class="train-best-for">
                    <strong>Best For:</strong>
                    <span data-field="best-for"></span>
                </p>
            </article>
        </template>

    </section>

    <%- include('./partials/footer') %>